opt_out_usage

IOS_BUNDLE_IDENTIFIERS = [
  "com.justin.henry.ume.ios",
  "com.justin.henry.ume.ios.extension"
].freeze

MACOS_BUNDLE_IDENTIFIERS = [
  "com.justin.henry.ume",
  "com.justin.henry.ume.extension"
].freeze

def required_environment_value(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable #{name}") if value.to_s.empty?
  value
end

def match_profile_name(bundle_identifier:, type:, platform:)
  components = ["sigh", bundle_identifier, type]
  components << platform unless platform == "ios"
  required_environment_value("#{components.join("_")}_profile-name")
end

def with_manual_release_signing(settings)
  project_path = File.expand_path("../Safari/Ume/Ume.xcodeproj/project.pbxproj", __dir__)
  original = File.binread(project_path)
  updated = original.dup

  settings.each do |setting|
    configuration_id = Regexp.escape(setting.fetch(:configuration_id))
    pattern = /(#{configuration_id} \/\* Release configuration[^\n]*\*\/ = \{.*?buildSettings = \{\n)(.*?)(\n\s*\};\n\s*name = Release;)/m
    match = updated.match(pattern)
    UI.user_error!("Could not find Release configuration #{setting[:configuration_id]}") unless match

    build_settings = match[2]
    UI.user_error!("Release configuration #{setting[:configuration_id]} is not using automatic signing") unless build_settings.include?("CODE_SIGN_STYLE = Automatic;")

    replacement = build_settings.sub("CODE_SIGN_STYLE = Automatic;", "CODE_SIGN_STYLE = Manual;")
    signing_lines = "\t\t\t\tCODE_SIGN_IDENTITY = \"#{setting.fetch(:identity)}\";\n" \
                    "\t\t\t\tPROVISIONING_PROFILE_SPECIFIER = \"#{setting.fetch(:profile)}\";\n"
    replacement = replacement.sub(/(\s*CODE_SIGN_ENTITLEMENTS = [^\n]+;\n)/, "\\1#{signing_lines}")
    updated.sub!(pattern, "\\1#{replacement}\\3")
  end

  File.binwrite(project_path, updated)
  yield
ensure
  File.binwrite(project_path, original) if original
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: required_environment_value("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: required_environment_value("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: required_environment_value("APP_STORE_CONNECT_PRIVATE_KEY_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

def signing_assets(type:, platform:, identifiers:, readonly:, api_key: app_store_connect_key)
  setup_ci if is_ci

  match(
    type: type,
    platform: platform,
    app_identifier: identifiers,
    api_key: api_key,
    readonly: readonly
  )
end

platform :ios do
  desc "Create or repair Ume's App Store signing assets from a trusted Mac"
  lane :bootstrap_signing do
    UI.user_error!("Signing bootstrap must run from a trusted local Mac, not CI.") if is_ci
    signing_assets(
      type: "appstore",
      platform: "ios",
      identifiers: IOS_BUNDLE_IDENTIFIERS,
      readonly: false
    )
  end

  desc "Install Ume's existing App Store signing assets without changing them"
  lane :sync_signing do
    signing_assets(
      type: "appstore",
      platform: "ios",
      identifiers: IOS_BUNDLE_IDENTIFIERS,
      readonly: true
    )
  end

  desc "Build a signed App Store archive and upload it to TestFlight"
  lane :release do |options|
    version = options[:version].to_s
    build_number = options[:build_number].to_s
    UI.user_error!("version is required") if version.empty?
    UI.user_error!("build_number is required") if build_number.empty?

    api_key = app_store_connect_key
    signing_assets(
      type: "appstore",
      platform: "ios",
      identifiers: IOS_BUNDLE_IDENTIFIERS,
      readonly: true,
      api_key: api_key
    )

    ipa_path = nil
    with_manual_release_signing([
      {
        configuration_id: "D0A1D323301B98AE0082FD16",
        identity: "Apple Distribution",
        profile: match_profile_name(bundle_identifier: IOS_BUNDLE_IDENTIFIERS[0], type: "appstore", platform: "ios")
      },
      {
        configuration_id: "D0A1D31F301B98AE0082FD16",
        identity: "Apple Distribution",
        profile: match_profile_name(bundle_identifier: IOS_BUNDLE_IDENTIFIERS[1], type: "appstore", platform: "ios")
      }
    ]) do
      ipa_path = build_app(
        project: "Safari/Ume/Ume.xcodeproj",
        scheme: "Ume (iOS)",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        output_directory: "build/ios",
        output_name: "Ume-#{version}.ipa",
        xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :mac do
  desc "Create or repair Ume's Developer ID signing assets from a trusted Mac"
  lane :bootstrap_signing do
    UI.user_error!("Signing bootstrap must run from a trusted local Mac, not CI.") if is_ci
    signing_assets(
      type: "developer_id",
      platform: "macos",
      identifiers: MACOS_BUNDLE_IDENTIFIERS,
      readonly: false,
      api_key: nil
    )
  end

  desc "Install Ume's existing Developer ID signing assets without changing them"
  lane :sync_signing do
    signing_assets(
      type: "developer_id",
      platform: "macos",
      identifiers: MACOS_BUNDLE_IDENTIFIERS,
      readonly: true
    )
  end

  desc "Build a signed Developer ID app for notarization"
  lane :release do |options|
    version = options[:version].to_s
    build_number = options[:build_number].to_s
    UI.user_error!("version is required") if version.empty?
    UI.user_error!("build_number is required") if build_number.empty?

    signing_assets(
      type: "developer_id",
      platform: "macos",
      identifiers: MACOS_BUNDLE_IDENTIFIERS,
      readonly: true
    )

    with_manual_release_signing([
      {
        configuration_id: "D0A1D32A301B98AE0082FD16",
        identity: "Developer ID Application",
        profile: match_profile_name(bundle_identifier: MACOS_BUNDLE_IDENTIFIERS[0], type: "developer_id", platform: "macos")
      },
      {
        configuration_id: "D0A1D326301B98AE0082FD16",
        identity: "Developer ID Application",
        profile: match_profile_name(bundle_identifier: MACOS_BUNDLE_IDENTIFIERS[1], type: "developer_id", platform: "macos")
      }
    ]) do
      build_app(
        project: "Safari/Ume/Ume.xcodeproj",
        scheme: "Ume (macOS)",
        configuration: "Release",
        clean: true,
        export_method: "developer-id",
        output_directory: "build/macos",
        output_name: "Ume",
        xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end
  end
end
